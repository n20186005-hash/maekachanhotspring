{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mae-kachan-hot-spring",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Astro emits prerendered HTML as static assets plus a Worker that only
  // handles the on-demand routes (see dist/_routes.json).
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
