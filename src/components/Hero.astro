---
import { getI18n } from '../i18n/ui';
import { siteConfig, attraction } from '../config';
import photos from '../data/gallery.json';

const { messages } = getI18n(Astro.url);
const hero = messages.hero;

// The featured photograph is the first entry of the generated gallery manifest,
// which already carries the optimised 1600px WebP + JPEG pair and its exact
// pixel dimensions (so the hero paints without layout shift).
const heroPhoto = photos[0];
const heroAlt = `${attraction.fullName} - Main view in ${attraction.city}, ${attraction.country}`;
---

<section
  id="attraction"
  class="hero"
  style="background-color: var(--color-nature-800);"
  aria-label={attraction.fullName}
>
  {heroPhoto ? (
    <picture class="hero-picture">
      <source type="image/webp" srcset={`/gallery/${heroPhoto.base}.webp`} />
      <img
        class="hero-bg"
        src={`/gallery/${heroPhoto.base}.jpg`}
        alt={heroAlt}
        width={heroPhoto.full.width}
        height={heroPhoto.full.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  ) : (
    <img class="hero-bg" src={attraction.heroImage} alt={heroAlt} loading="eager" fetchpriority="high" decoding="async" />
  )}

  <div class="hero-inner">
    <span class="hero-badge animate-fade-in-up">{hero.badge}</span>
    <h1 class="hero-title animate-fade-in-up animation-delay-100">{hero.title}</h1>
    <p class="hero-subtitle animate-fade-in-up animation-delay-200">{hero.subtitle}</p>
    <p class="hero-desc animate-fade-in-up animation-delay-200">{hero.desc}</p>

    <div class="hero-facts animate-fade-in-up animation-delay-300">
      <div class="hero-fact">
        <span class="hero-fact-icon">⭐</span>
        <span class="hero-fact-label">{hero.factRating}</span>
        <span class="hero-fact-value">{hero.ratingValue}</span>
        <span class="hero-fact-sub">{hero.ratingCount}</span>
      </div>
      <div class="hero-fact">
        <span class="hero-fact-icon">🕕</span>
        <span class="hero-fact-label">{hero.factHours}</span>
        <span class="hero-fact-value">{hero.hoursValue}</span>
      </div>
      <div class="hero-fact">
        <span class="hero-fact-icon">🎟️</span>
        <span class="hero-fact-label">{hero.factAdmission}</span>
        <span class="hero-fact-value">{hero.admissionValue}</span>
      </div>
    </div>

    <!-- MAP LINK #1 (Hero) -->
    <a class="btn-cta btn-cta-primary animate-fade-in-up animation-delay-400" href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer">
      📍 {hero.ctaMaps}
    </a>
  </div>
</section>
