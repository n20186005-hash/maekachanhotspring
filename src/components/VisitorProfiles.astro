---
import { getI18n } from '../i18n/ui';
import { getGuide } from '../data/guide';

const { lang } = getI18n(Astro.url);
const p = getGuide(lang).profiles;
---

<section id="plans" class="section-padding" style="background: var(--bg-tertiary);">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="section-title">{p.title}</h2>
    <p class="section-subtitle">{p.subtitle}</p>

    <div class="profile-grid">
      {p.items.map((profile) => (
        <article class="profile-card">
          <div class="profile-head">
            <span class="profile-icon" aria-hidden="true">{profile.icon}</span>
            <div>
              <h3 class="profile-name">{profile.name}</h3>
              <p class="profile-audience">{profile.audience}</p>
            </div>
          </div>

          <p class="profile-plan">{profile.plan}</p>

          <h4 class="profile-subtitle">{p.highlightsLabel}</h4>
          <ul class="profile-list">
            {profile.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          <div class="profile-caution">
            <h4 class="profile-subtitle">{p.cautionsLabel}</h4>
            <p>{profile.cautions}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
