---
import { getI18n } from '../i18n/ui';
import { getGuide } from '../data/guide';
import { fetchWeather, type WeatherData } from '../lib/weather';
import { beaufort, conditionIcon, conditionKey, focusDayIndex } from '../lib/conditions';
import { buildAdvice } from '../lib/advice';

const { lang, messages } = getI18n(Astro.url);
const g = getGuide(lang).weather;
const advice = g.advice;

// First paint comes from a server-side fetch; the module script below keeps the
// panel current afterwards without a full page reload.
let data: WeatherData | null = null;
try {
  data = await fetchWeather();
} catch {
  data = null;
}

const locale = lang === 'zh' ? 'zh-CN' : lang === 'th' ? 'th-TH' : 'en-GB';
const conditions = (messages.weather?.conditions ?? {}) as Record<string, string>;

const round0 = (n: number) => Math.round(n);
const round1 = (n: number) => Math.round(n * 10) / 10;
const condLabel = (code: number) => conditions[conditionKey(code)] ?? '';

const clockOf = (iso: string) => {
  try {
    return new Intl.DateTimeFormat(locale, {
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'Asia/Bangkok',
    }).format(new Date(iso));
  } catch {
    return '--:--';
  }
};

const weekdayOf = (iso: string) => {
  try {
    return new Intl.DateTimeFormat(locale, { weekday: 'short' }).format(new Date(`${iso}T12:00:00+07:00`));
  } catch {
    return iso.slice(5);
  }
};

const current = data?.current ?? null;
const today = data?.daily?.[0] ?? null;

// Late in the evening there is nothing left of today to plan around, so the
// advice — and the highlighted day — roll forward to tomorrow.
const focusIndex = data ? focusDayIndex(data.updated, data.daily.length) : 0;

const currentKey = current ? conditionKey(current.code) : 'partlyCloudy';
const windLevel = current ? beaufort(current.wind) : 0;

// Seven slots are always rendered so the client refresh patches values in place.
const slots = Array.from({ length: 7 }, (_, i) => {
  const day = data?.daily?.[i];
  const key = day ? conditionKey(day.code) : 'partlyCloudy';
  return {
    name: day ? weekdayOf(day.date) : '—',
    icon: day ? conditionIcon(key, true) : '⛅',
    cond: day ? conditions[key] ?? '' : '',
    max: day ? `${round0(day.max)}°` : '—',
    min: day ? `${round0(day.min)}°` : '—',
    rain: day ? `${round0(day.precipProb)}%` : '—',
  };
});

const adviceResult = data
  ? buildAdvice(data, advice.copy, { focusIndex })
  : { risk: [], outfit: [], plan: [], pack: [] };

const adviceGroups = [
  { key: 'outfit', icon: '👕', title: advice.groupOutfit },
  { key: 'plan', icon: '🗺️', title: advice.groupPlan },
  { key: 'pack', icon: '🎒', title: advice.groupPack },
] as const;

// Only the strings the browser needs for a re-render — keeps the payload small
// and avoids shipping the whole guide bundle to the client.
const clientStrings = {
  locale,
  conditions,
  copy: advice.copy,
  scaleUnit: g.scaleUnit,
  windUnit: g.windUnit,
  high: g.high,
  low: g.low,
};
---

<section id="weather" class="section-padding weather-section">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="section-title">{g.title}</h2>
    <p class="section-subtitle">{g.subtitle}</p>

    <div class="wx-panel" data-wx data-endpoint="/api/weather">
      <!-- Risk alerts sit above everything else and only appear when warranted. -->
      <div class="wx-risk" data-wx-risk hidden={adviceResult.risk.length === 0}>
        <p class="wx-risk-heading">⚠️ {advice.riskTitle}</p>
        <ul class="wx-risk-list" data-wx-risk-list>
          {adviceResult.risk.map((item) => (
            <li class={`wx-risk-item wx-risk-${item.severity}`}>{item.label}</li>
          ))}
        </ul>
        <p class="wx-risk-note">{advice.riskNote}</p>
      </div>

      <p class="wx-risk-none" data-wx-risk-none hidden={adviceResult.risk.length > 0}>✔ {advice.noRisk}</p>

      <!-- Current conditions -->
      <div class="wx-now">
        <div class="wx-now-head">
          <span class="wx-icon" data-w-icon aria-hidden="true">
            {current ? conditionIcon(currentKey, current.isDay) : '⛅'}
          </span>
          <div class="wx-now-main">
            <p class="wx-label">{g.nowLabel}</p>
            <p class="wx-temp">
              <span data-w-temp>{current ? round0(current.temp) : '—'}</span><span class="wx-unit">°C</span>
            </p>
            <p class="wx-cond" data-w-cond>{current ? condLabel(current.code) : g.loading}</p>
            {today && (
              <p class="wx-range" data-w-range>
                {g.high} {round0(today.max)}° · {g.low} {round0(today.min)}°
              </p>
            )}
          </div>
        </div>

        <dl class="wx-metrics">
          <div>
            <dt>{g.feelsLike}</dt>
            <dd><span data-w-apparent>{current ? round0(current.apparent) : '—'}</span>°C</dd>
          </div>
          <div>
            <dt>{g.humidity}</dt>
            <dd><span data-w-humidity>{current ? round0(current.humidity) : '—'}</span>%</dd>
          </div>
          <div>
            <dt>{g.wind}</dt>
            <dd>
              <span data-w-wind>{current ? `${windLevel} ${g.scaleUnit}` : '—'}</span>
              <span class="wx-metric-sub" data-w-wind-kmh>
                {current ? ` · ${round1(current.wind)} ${g.windUnit}` : ''}
              </span>
            </dd>
          </div>
          <div>
            <dt>{g.rain}</dt>
            <dd><span data-w-rain>{current ? round0(current.precipProb) : '—'}</span>%</dd>
          </div>
          <div>
            <dt>{g.uv}</dt>
            <dd><span data-w-uv>{current ? round0(current.uv) : '—'}</span></dd>
          </div>
        </dl>

        <p class="wx-updated">
          {g.updated} <span data-w-updated>{data ? clockOf(data.updated) : '--:--'}</span>
        </p>
      </div>

      <!-- Actionable advice: only triggered lines are rendered -->
      <div class="wx-advice">
        {adviceGroups.map((group) => {
          const items = adviceResult[group.key];
          return (
            <div class="wx-group" data-wx-group={group.key} hidden={items.length === 0}>
              <h3 class="wx-group-title">
                <span aria-hidden="true">{group.icon}</span> {group.title}
              </h3>
              <ul class={group.key === 'pack' ? 'wx-list wx-list-chips' : 'wx-list'} data-wx-list>
                {items.map((item) => (
                  <li class={group.key === 'pack' ? 'wx-chip' : 'wx-item'}>
                    {group.key === 'pack' && item.icon && <span class="wx-chip-icon" aria-hidden="true">{item.icon}</span>}
                    <span>{item.label}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>

      <!-- Seven-day outlook -->
      <div class="wx-forecast">
        <h3 class="wx-forecast-title">{g.forecastTitle}</h3>
        <ul class="wx-days">
          {slots.map((slot, i) => (
            <li class="wx-day" class:list={[{ 'wx-day-today': i === focusIndex }]}>
              <span class="wx-day-name" data-w-dname>{slot.name}</span>
              <span class="wx-day-icon" data-w-dicon aria-hidden="true">{slot.icon}</span>
              <span class="wx-day-cond" data-w-dcond>{slot.cond}</span>
              <span class="wx-day-temp">
                <b data-w-dmax>{slot.max}</b>
                <span data-w-dmin>{slot.min}</span>
              </span>
              <span class="wx-day-rain" data-w-drain>💧 {slot.rain}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="wx-note">{g.footnote}</p>
  </div>
</section>

<script is:inline type="application/json" id="wx-strings" set:html={JSON.stringify(clientStrings)}></script>

<script>
  import { buildAdvice, PACK_ICONS } from '../lib/advice';
  import { beaufort, conditionIcon, conditionKey, focusDayIndex } from '../lib/conditions';

  const container = document.querySelector<HTMLElement>('[data-wx]');
  const stringsEl = document.getElementById('wx-strings');

  if (container && stringsEl) {
    // Re-bind to a non-nullable alias: the render helpers below are analysed as
    // standalone closures, where the outer control-flow narrowing no longer
    // applies, so they need a plain `HTMLElement`.
    const root = container;

    interface Strings {
      locale: string;
      conditions: Record<string, string>;
      copy: Record<string, string>;
      scaleUnit: string;
      windUnit: string;
      high: string;
      low: string;
    }

    let S: Strings = {
      locale: 'en-GB',
      conditions: {},
      copy: {},
      scaleUnit: '',
      windUnit: '',
      high: '',
      low: '',
    };
    try {
      S = { ...S, ...JSON.parse(stringsEl.textContent || '{}') };
    } catch {
      /* fall back to the server-rendered values */
    }

    const nodes = {
      icon: root.querySelector('[data-w-icon]'),
      temp: root.querySelector('[data-w-temp]'),
      cond: root.querySelector('[data-w-cond]'),
      range: root.querySelector('[data-w-range]'),
      apparent: root.querySelector('[data-w-apparent]'),
      humidity: root.querySelector('[data-w-humidity]'),
      wind: root.querySelector('[data-w-wind]'),
      windKmh: root.querySelector('[data-w-wind-kmh]'),
      rain: root.querySelector('[data-w-rain]'),
      uv: root.querySelector('[data-w-uv]'),
      updated: root.querySelector('[data-w-updated]'),
      risk: root.querySelector<HTMLElement>('[data-wx-risk]'),
      riskList: root.querySelector('[data-wx-risk-list]'),
      riskNone: root.querySelector<HTMLElement>('[data-wx-risk-none]'),
    };

    const round0 = (n: number) => Math.round(n);
    const round1 = (n: number) => Math.round(n * 10) / 10;
    const label = (code: number) => S.conditions[conditionKey(code)] ?? '';

    const clock = (iso: string) => {
      try {
        return new Intl.DateTimeFormat(S.locale, {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZone: 'Asia/Bangkok',
        }).format(new Date(iso));
      } catch {
        return '--:--';
      }
    };

    const weekday = (iso: string) => {
      try {
        return new Intl.DateTimeFormat(S.locale, { weekday: 'short' }).format(new Date(`${iso}T12:00:00+07:00`));
      } catch {
        return iso.slice(5);
      }
    };

    const setText = (el: Element | null, value: string) => {
      if (el && el.textContent !== value) el.textContent = value;
    };

    const el = (tag: string, className?: string, text?: string) => {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text != null) node.textContent = text;
      return node;
    };

    function renderAdvice(payload: any, focusIndex: number) {
      const advice = buildAdvice(payload, S.copy, { focusIndex });

      if (nodes.riskList) {
        nodes.riskList.replaceChildren(
          ...advice.risk.map((item) => el('li', `wx-risk-item wx-risk-${item.severity}`, item.label))
        );
      }
      const hasRisk = advice.risk.length > 0;
      if (nodes.risk) nodes.risk.hidden = !hasRisk;
      if (nodes.riskNone) nodes.riskNone.hidden = hasRisk;

      (['outfit', 'plan', 'pack'] as const).forEach((name) => {
        const box = root.querySelector<HTMLElement>(`[data-wx-group="${name}"]`);
        if (!box) return;
        const list = box.querySelector('[data-wx-list]');
        const items = advice[name];
        box.hidden = items.length === 0;
        if (!list) return;
        list.replaceChildren(
          ...items.map((item) => {
            const li = el('li', name === 'pack' ? 'wx-chip' : 'wx-item');
            if (name === 'pack') {
              const icon = item.icon ?? PACK_ICONS[item.key];
              if (icon) li.appendChild(el('span', 'wx-chip-icon', icon));
            }
            li.appendChild(el('span', undefined, item.label));
            return li;
          })
        );
      });
    }

    function render(payload: any) {
      if (!payload?.current) return;
      const now = payload.current;
      const day = payload.daily?.[0];
      const key = conditionKey(now.code);
      const focusIndex = focusDayIndex(payload.updated, (payload.daily ?? []).length);

      setText(nodes.icon, conditionIcon(key, now.isDay));
      setText(nodes.temp, String(round0(now.temp)));
      setText(nodes.cond, label(now.code));
      setText(nodes.apparent, String(round0(now.apparent)));
      setText(nodes.humidity, String(round0(now.humidity)));
      setText(nodes.wind, `${beaufort(now.wind)} ${S.scaleUnit}`.trim());
      setText(nodes.windKmh, ` · ${round1(now.wind)} ${S.windUnit}`.trim());
      setText(nodes.rain, String(round0(now.precipProb)));
      setText(nodes.uv, String(round0(now.uv)));
      setText(nodes.updated, clock(payload.updated));
      if (nodes.range && day) {
        setText(nodes.range, `${S.high} ${round0(day.max)}° · ${S.low} ${round0(day.min)}°`);
      }

      const days = root.querySelectorAll('.wx-day');
      (payload.daily ?? []).slice(0, days.length).forEach((item: any, i: number) => {
        const row = days[i];
        row.classList.toggle('wx-day-today', i === focusIndex);
        setText(row.querySelector('[data-w-dname]'), weekday(item.date));
        setText(row.querySelector('[data-w-dicon]'), conditionIcon(conditionKey(item.code), true));
        setText(row.querySelector('[data-w-dcond]'), label(item.code));
        setText(row.querySelector('[data-w-dmax]'), `${round0(item.max)}°`);
        setText(row.querySelector('[data-w-dmin]'), `${round0(item.min)}°`);
        setText(row.querySelector('[data-w-drain]'), `💧 ${round0(item.precipProb)}%`);
      });

      renderAdvice(payload, focusIndex);
    }

    const endpoint = root.getAttribute('data-endpoint') || '/api/weather';
    fetch(endpoint, { headers: { accept: 'application/json' } })
      .then((response) => (response.ok ? response.json() : null))
      .then((payload) => {
        if (payload && !payload.error) render(payload);
      })
      .catch(() => {
        /* keep the server-rendered values */
      });
  }
</script>
