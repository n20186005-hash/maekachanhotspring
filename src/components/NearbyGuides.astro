---
import { getI18n } from '../i18n/ui';
import { topics } from '../data/topics';
const { lang } = getI18n(Astro.url);
const field = lang === 'th' ? 2 : lang === 'zh' ? 3 : 1;
const title = lang === 'th' ? 'เที่ยวต่อและวางแผนรอบน้ำพุร้อนแม่ขะจาน' : lang === 'zh' ? '周边游览与行程指南' : 'Explore nearby and plan your stop';
const subtitle = lang === 'th' ? 'เลือกเส้นทาง กิจกรรม และข้อมูลก่อนเดินทาง โดยยังคงอยู่ในเว็บไซต์เดียวกัน' : lang === 'zh' ? '从温泉体验、交通、摄影到周边景点，按需求进入对应专题。' : 'Choose focused guides for hot-spring experiences, transport, photos and regional excursions.';
const featured = ['nearby-attractions','chiang-mai-to-chiang-rai','egg-boiling','foot-soak','best-time','photography'];
---
<section class="section-padding" id="nearby-guides" style="background:var(--bg-secondary)">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-10"><h2 class="text-3xl md:text-4xl font-bold text-primary mb-4">{title}</h2><p class="text-secondary max-w-2xl mx-auto">{subtitle}</p></div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featured.map((slug,i) => { const entry=topics.find(t=>t[0]===slug)!; return <a class="bg-surface border border-border rounded-2xl overflow-hidden hover:shadow-lg transition-shadow" href={`/${lang}/guides/${slug}/`}><img class="w-full h-44 object-cover" src={`/gallery/mae-kachan-hot-spring-${i+1}.jpg`} alt={`Mae Kachan Hot Spring — ${entry[field]}`} loading="lazy" width="640" height="360"/><div class="p-5"><h3 class="text-xl font-bold text-primary mb-2">{entry[field]}</h3><p class="text-sm text-secondary leading-relaxed">{entry[field+3]}</p></div></a>; })}
    </div>
    <div class="text-center mt-8"><a class="inline-block px-6 py-3 rounded-xl bg-primary text-white font-semibold" href={`/${lang}/guides/`}>{lang === 'th' ? 'ดูคู่มือทั้งหมด 30 หัวข้อ' : lang === 'zh' ? '查看全部 30 篇专题' : 'Browse all 30 guides'}</a></div>
  </div>
</section>
