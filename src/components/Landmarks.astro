---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const l = messages.landmarks;
const items = l.items;
---

<section id="landmarks" class="section-padding" style="background: var(--bg-tertiary);">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="section-title">{l.title}</h2>
    <p class="section-subtitle">{l.subtitle}</p>

    <!-- Semantic cluster: binds the entity with its surrounding landmarks -->
    <p class="text-center max-w-3xl mx-auto mb-10 leading-relaxed" style="color: var(--text-secondary);">
      {l.intro}
    </p>

    <div class="grid sm:grid-cols-2 gap-5">
      {items.map((it: any) => (
        <article class="card">
          <div class="flex items-start justify-between gap-3 mb-2">
            <h3 class="font-display text-lg font-semibold m-0" style="color: var(--text-primary);">{it.name}</h3>
            <span class="tag shrink-0">{it.distance}</span>
          </div>
          <p class="text-sm m-0 mb-2" style="color: var(--text-muted);">{it.local}</p>
          <p class="text-sm leading-relaxed m-0" style="color: var(--text-secondary);">{it.text}</p>
        </article>
      ))}
    </div>

    <p class="text-center text-xs mt-8" style="color: var(--text-muted);">{l.distanceLabel}</p>
  </div>
</section>
