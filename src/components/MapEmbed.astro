---
import { getI18n } from '../i18n/ui';
import { attraction, mapsEmbedSrc, siteConfig } from '../config';

const { lang, messages } = getI18n(Astro.url);
const m = messages.map;
const s = messages.sources;
const embedSrc = mapsEmbedSrc(lang);
---

<section id="map" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="section-title">{m.title}</h2>
    <p class="section-subtitle">{m.subtitle}</p>

    <div class="map-container rounded-2xl overflow-hidden border" style="border-color: var(--map-border); box-shadow: var(--card-shadow);">
      <iframe
        src={embedSrc}
        width="100%"
        height="450"
        style="border:0;"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        title={m.embedTitle}
        allowfullscreen
      ></iframe>
    </div>

    <p class="text-center text-sm mt-4" style="color: var(--text-muted);">{m.note}</p>

    <p class="text-center text-sm mt-2" style="color: var(--text-secondary);">
      {s.officialText}
      <a href={attraction.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="hover:opacity-70" style="color: var(--accent); text-decoration: underline; text-underline-offset: 3px;">
        {s.officialLinkLabel}
      </a>.
    </p>

    <p class="text-center text-xs mt-4" style="color: var(--text-muted);">{attraction.plusCode}</p>

    <div class="text-center mt-6">
      <a class="footer-maps-link" href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer">
        📍 {messages.common.googleMaps} →
      </a>
    </div>
  </div>
</section>
