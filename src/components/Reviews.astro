---
import { getI18n } from '../i18n/ui';
import { siteConfig, attraction } from '../config';

const { messages } = getI18n(Astro.url);
const r = messages.reviews;

function stars(n: number) {
  let out = '';
  for (let i = 1; i <= 5; i++) {
    out += `<span class="${i <= n ? 'star-filled' : 'star-empty'}">★</span>`;
  }
  return out;
}
---

<section id="reviews" class="section-padding" style="background: var(--bg-tertiary);">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="section-title">{r.title}</h2>
    <p class="section-subtitle">{r.subtitle}</p>

    <div class="flex items-center justify-center gap-2 mb-2">
      <span class="text-2xl font-bold" style="color: var(--accent);">{attraction.ratingValue}</span>
      <span class="text-lg" set:html={stars(4)}></span>
      <span class="text-sm" style="color: var(--text-secondary);">{r.ratingSummary}</span>
    </div>

    <!-- Aggregated score from Google Maps; we intentionally do not reproduce
         individual visitor reviews, only the verified snapshot and a link. -->
    <p class="text-center text-xs mb-4" style="color: var(--text-muted);">
      <a href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer" class="hover:opacity-70" style="color: var(--text-muted); text-decoration: underline; text-underline-offset: 3px;">
        {r.ratingSource}
      </a>
    </p>

    <p class="text-center text-sm max-w-2xl mx-auto mb-8" style="color: var(--text-secondary);">
      {r.snapshotNote}
    </p>

    <div class="text-center">
      <!-- MAP LINK #3 (Reviews) -->
      <a class="btn-cta btn-cta-primary" href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer">
        📍 {r.viewLocation}
      </a>
    </div>
  </div>
</section>
