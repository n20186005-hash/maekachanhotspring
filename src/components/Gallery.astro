---
import { getI18n } from '../i18n/ui';
import { siteConfig, attraction } from '../config';
import photos from '../data/gallery.json';

const { messages } = getI18n(Astro.url);
const g = messages.gallery;

// Every photograph ships as a 640px WebP + JPEG thumbnail for the grid and a
// 1600px WebP + JPEG master for the lightbox. Dimensions come from the
// generated manifest so the browser can reserve the right box straight away.
const photoAlt = (i: number) =>
  `${attraction.fullName} in ${attraction.city}, ${attraction.country} — photo ${i + 1}`;

// 1x1 transparent GIF used until the lightbox opens, so no request is made for
// an empty `src`.
const PLACEHOLDER = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
---

<section id="gallery" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="section-title">{g.title}</h2>
    <p class="section-subtitle">{g.subtitle}</p>

    <div class="gallery-grid" id="gallery-grid">
      {photos.map((photo, i) => (
        <button
          type="button"
          class="gallery-item"
          data-webp={`/gallery/${photo.base}.webp`}
          data-jpg={`/gallery/${photo.base}.jpg`}
          data-alt={photoAlt(i)}
          aria-label={photoAlt(i)}
        >
          <picture>
            <source type="image/webp" srcset={`/gallery/thumbs/${photo.base}.webp`} />
            <img
              src={`/gallery/thumbs/${photo.base}.jpg`}
              alt={photoAlt(i)}
              width={photo.thumb.width}
              height={photo.thumb.height}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </picture>
        </button>
      ))}
    </div>

    <p class="text-center text-xs mt-4" style="color: var(--text-muted);">{messages.sources.photoRights}</p>

    <div class="text-center mt-6">
      <!-- MAP LINK #2 (Gallery) -->
      <a class="btn-cta btn-cta-primary" href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer">
        📍 {g.viewLocation}
      </a>
    </div>
  </div>
</section>

<!-- Lightbox -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true">
  <button type="button" class="lightbox-close" id="lightbox-close" aria-label="Close">×</button>
  <button type="button" class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous">‹</button>
  <figure class="lightbox-figure">
    <picture>
      <source id="lightbox-webp" type="image/webp" />
      <img id="lightbox-img" src={PLACEHOLDER} alt="" />
    </picture>
    <figcaption id="lightbox-caption">{g.title}</figcaption>
  </figure>
  <button type="button" class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next">›</button>
</div>

<script is:inline>
  (function () {
    var grid = document.getElementById('gallery-grid');
    if (!grid) return;
    var items = Array.from(grid.querySelectorAll('.gallery-item'));
    var lb = document.getElementById('lightbox');
    var lbImg = document.getElementById('lightbox-img');
    var lbWebp = document.getElementById('lightbox-webp');
    var lbCap = document.getElementById('lightbox-caption');
    var caption = lbCap ? lbCap.textContent : '';
    var current = 0;

    function open(idx) {
      current = idx;
      var el = items[idx];
      var jpg = el.getAttribute('data-jpg');
      var webp = el.getAttribute('data-webp');
      var alt = el.getAttribute('data-alt') || caption;
      if (lbWebp) lbWebp.srcset = webp || '';
      if (lbImg) {
        lbImg.src = jpg || '';
        lbImg.alt = alt;
      }
      if (lb) lb.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      if (lb) lb.classList.remove('is-open');
      document.body.style.overflow = '';
    }
    function step(d) {
      current = (current + d + items.length) % items.length;
      open(current);
    }

    items.forEach(function (el, i) {
      el.addEventListener('click', function () { open(i); });
    });
    var closeBtn = document.getElementById('lightbox-close');
    var prevBtn = document.getElementById('lightbox-prev');
    var nextBtn = document.getElementById('lightbox-next');
    if (closeBtn) closeBtn.addEventListener('click', close);
    if (prevBtn) prevBtn.addEventListener('click', function (e) { e.stopPropagation(); step(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function (e) { e.stopPropagation(); step(1); });
    if (lb) lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
    document.addEventListener('keydown', function (e) {
      if (!lb || !lb.classList.contains('is-open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
  })();
</script>
