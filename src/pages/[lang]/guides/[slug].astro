---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languagesList, getI18n } from '../../../i18n/ui';
import { topics } from '../../../data/topics';
import { siteConfig } from '../../../config';
export function getStaticPaths() { return languagesList.flatMap(lang => topics.map(topic => ({ params: { lang, slug: topic[0] } }))); }
const { lang } = getI18n(Astro.url);
const slug = Astro.params.slug;
const topic = topics.find(t => t[0] === slug)!;
const index = topics.findIndex(t => t[0] === slug);
const locale = lang === 'th' ? 2 : lang === 'zh' ? 3 : 1;
const title = topic[locale];
const summary = topic[locale + 3];
const copy = {
  en: {home:'Home', hub:'All visitor guides', about:'About Mae Kachan Hot Spring', aboutText:'Mae Kachan Hot Spring (น้ำพุร้อนแม่ขะจาน) is a geothermal roadside stop in Mae Chedi Mai, Wiang Pa Pao District, Chiang Rai Province. It is on Highway 118 between Chiang Mai and Chiang Rai. The developed roadside stop is known for rising steam, egg-boiling and designated foot-soaking facilities.', plan:'Plan your visit', steps:['Find the precise Mae Kachan Hot Spring location before departing, not another hot spring with a similar name.','Check weather, road conditions and available services; schedules and fees may change.','Stop only in marked areas, enjoy the geothermal feature at a safe distance and allow time to continue your route.'], practical:'Visitor information', where:'Location', roads:'Road access', time:'Suggested time', timeValue:'Allow a flexible short stop; add time if using food stalls or foot baths.', safe:'Safety note', safeText:'Water at natural vents may cause serious burns. Use only designated visitor areas and follow signs. Children need constant supervision.', management:'About the site and management', managementText:'Mae Kachan is a visitor area within Wiang Pa Pao District of Chiang Rai Province. The operator of each individual facility or stall may differ; check the notices displayed on site for the responsible provider.', more:'Continue planning', maps:'View exact location on Google Maps', transport:'Detailed transport guide', source:'Location context: Chiang Rai tourism directory and Thailand tourism brochure. Services and prices should be confirmed on site.'},
  th: {home:'หน้าแรก',hub:'คู่มือทั้งหมด',about:'เกี่ยวกับน้ำพุร้อนแม่ขะจาน',aboutText:'น้ำพุร้อนแม่ขะจานตั้งอยู่ที่ตำบลแม่เจดีย์ใหม่ อำเภอเวียงป่าเป้า จังหวัดเชียงราย ริมทางหลวง 118 ระหว่างเชียงใหม่และเชียงราย เป็นจุดพักรถที่มีไอน้ำจากธรรมชาติ กิจกรรมต้มไข่ และพื้นที่แช่เท้าที่จัดไว้สำหรับผู้มาเยือน',plan:'วางแผนก่อนเดินทาง',steps:['ตรวจสอบหมุดน้ำพุร้อนแม่ขะจานให้ตรง ไม่สับสนกับน้ำพุร้อนแห่งอื่น','ตรวจสอบอากาศ สภาพถนน ค่าบริการ และเวลาให้บริการที่อาจเปลี่ยนได้','จอดรถในพื้นที่กำหนด ชมน้ำพุร้อนจากจุดปลอดภัย และเผื่อเวลาเดินทางต่อ'],practical:'ข้อมูลสำหรับผู้เที่ยว',where:'ที่ตั้ง',roads:'การเดินทาง',time:'เวลาที่ควรเผื่อ',timeValue:'แวะพักแบบยืดหยุ่น และเผื่อเพิ่มหากจะกินอาหารหรือนั่งแช่เท้า',safe:'ข้อควรระวัง',safeText:'น้ำบริเวณหัวพุอาจทำให้ลวกอย่างรุนแรง เข้าเฉพาะพื้นที่ที่จัดไว้ ปฏิบัติตามป้ายและดูแลเด็กตลอดเวลา',management:'เกี่ยวกับพื้นที่และผู้ดูแล',managementText:'น้ำพุร้อนแม่ขะจานอยู่ในอำเภอเวียงป่าเป้า จังหวัดเชียงราย ผู้ให้บริการแต่ละจุดหรือร้านค้าอาจเป็นคนละราย โปรดดูประกาศของสถานที่เพื่อทราบผู้รับผิดชอบบริการนั้น',more:'วางแผนต่อ',maps:'ดูตำแหน่งใน Google Maps',transport:'คู่มือการเดินทาง',source:'อ้างอิงบริบทที่ตั้งจากข้อมูลท่องเที่ยวเชียงรายและเอกสารท่องเที่ยวประเทศไทย โปรดตรวจสอบบริการและราคาหน้างาน'},
  zh: {home:'首页',hub:'全部游览指南',about:'关于湄卡占温泉',aboutText:'湄卡占温泉（Mae Kachan Hot Spring／น้ำพุร้อนแม่ขะจาน）位于泰国清莱府 Wiang Pa Pao 县 Mae Chedi Mai 一带，坐落在连接清迈与清莱的118号公路旁。沿线可观察天然蒸汽，也有煮蛋及指定泡脚设施，是常见的自驾中途休息点。',plan:'出发前如何安排',steps:['核对湄卡占温泉专属地图位置，避免误导航到名称相似的其他温泉。','查看天气、路况与设施开放情况；服务时段及收费以现场为准。','在指定位置停车，保持与泉眼的安全距离，为后续公路行程预留时间。'],practical:'实用游览信息',where:'地理位置',roads:'交通方式',time:'建议停留',timeValue:'按实际体验灵活安排短暂停留；若泡脚、购物或用餐，应额外预留时间。',safe:'安全提醒',safeText:'天然泉眼可能造成严重烫伤。请只在开放区域活动，遵守标识并全程看护儿童。',management:'关于景点与管理',managementText:'湄卡占温泉位于清莱府 Wiang Pa Pao 县辖区内；具体摊位、泡脚设施可能由不同经营者提供，请以现场公告确认相应设施的管理或服务主体。',more:'继续规划路线',maps:'在 Google 地图查看准确位置',transport:'详细交通指南',source:'地点信息参考清莱旅游资料及泰国旅游宣传资料；开放及收费细节请现场确认。'}
}[lang as 'en'|'th'|'zh'];
const related = [topics[(index + 1) % topics.length], topics[(index + 7) % topics.length], topics[(index + 17) % topics.length]];
const schema = {'@context':'https://schema.org','@type':'Article',headline:title,description:summary,mainEntityOfPage:`${siteConfig.baseUrl}/${lang}/guides/${slug}/`,about:{'@type':'TouristAttraction',name:'Mae Kachan Hot Spring'},inLanguage:lang};
---
<BaseLayout title={`${title} | Mae Kachan Hot Spring`} description={summary} path={`guides/${slug}`}>
  <Fragment slot="head"><script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} /></Fragment>
  <section class="hero" style="background-color:var(--color-nature-800);min-height:36vh;display:flex;align-items:center"><div class="hero-inner"><h1 class="hero-title">{title}</h1><p class="hero-subtitle">{summary}</p></div></section>
  <article class="max-w-4xl mx-auto px-4 py-12 space-y-12 text-color leading-relaxed">
    <nav class="text-sm flex gap-2 flex-wrap"><a class="text-primary underline" href={`/${lang}/`}>{copy.home}</a><span> / </span><a class="text-primary underline" href={`/${lang}/guides/`}>{copy.hub}</a><span> / {title}</span></nav>
    <section><h2 class="text-3xl font-bold text-primary mb-5">{copy.about}</h2><p class="text-lg">{copy.aboutText}</p><p class="mt-4">{summary}</p></section>
    <section class="bg-surface border border-border rounded-2xl p-7"><h2 class="text-2xl font-bold mb-5 text-primary">{copy.management}</h2><p>{copy.managementText}</p></section>
    <section><h2 class="text-3xl font-bold text-primary mb-5">{copy.practical}</h2><dl class="grid sm:grid-cols-2 gap-4"><div class="bg-surface rounded-xl p-5"><dt class="font-bold">{copy.where}</dt><dd>Mae Chedi Mai, Wiang Pa Pao, Chiang Rai, Thailand</dd></div><div class="bg-surface rounded-xl p-5"><dt class="font-bold">{copy.roads}</dt><dd>Highway 118 — Chiang Mai / Chiang Rai</dd></div><div class="bg-surface rounded-xl p-5 sm:col-span-2"><dt class="font-bold">{copy.time}</dt><dd>{copy.timeValue}</dd></div></dl></section>
    <section><h2 class="text-3xl font-bold text-primary mb-5">{copy.plan}</h2><ol class="space-y-4">{copy.steps.map((step,i) => <li class="flex gap-4"><span class="rounded-full bg-primary text-white w-9 h-9 shrink-0 flex items-center justify-center">{i+1}</span><p>{step}</p></li>)}</ol></section>
    <section class="bg-surface rounded-2xl p-7 border border-border"><h2 class="text-2xl font-bold mb-4 text-primary">{copy.safe}</h2><p>{copy.safeText}</p></section>
    <section><h2 class="text-2xl font-bold mb-4 text-primary">{copy.more}</h2><div class="flex flex-wrap gap-4"><a class="text-primary underline" href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer">{copy.maps}</a><a class="text-primary underline" href={`/${lang}/transport/`}>{copy.transport}</a></div><div class="grid md:grid-cols-3 gap-4 mt-6">{related.map(item => <a class="bg-surface border border-border p-5 rounded-xl hover:shadow-md" href={`/${lang}/guides/${item[0]}/`}>{item[locale]}</a>)}</div></section>
    <p class="text-sm text-secondary">{copy.source}</p>
  </article>
</BaseLayout>
